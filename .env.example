# ---------------------------------------------------------------- database
# Your Postgres (already running in Docker on :5432).
DATABASE_URL=postgresql://postgres:test1234@localhost:5432/juryview?schema=public
# Set to true only for managed Postgres that requires TLS.
PGSSL=false

# ---------------------------------------------------------------------- ai
# Which provider the juror agents use: groq | heuristic
# "heuristic" needs no key and runs offline — useful for demos.
AI_PROVIDER=groq

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b

# Point at any OpenAI-compatible endpoint to use a different provider.
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# How many juror agents call the model in parallel, and per-call timeout.
AI_CONCURRENCY=6
AI_TIMEOUT_MS=30000

# ------------------------------------------------------------- simulation
# Peer-influence passes per round of evidence.
DELIBERATION_PASSES=2

# ------------------------------------------------------------------ server
PORT=4100
# Set to false to skip creating the fictional demo case on first boot.
SEED_DEMO=true

# Max completion tokens per juror call (raise if JSON gets truncated).
# Leave unset to auto-size (2500 for reasoning models like gpt-oss, 900 otherwise).
# AI_MAX_TOKENS=900

# Back-office portal passphrase (soft gate at /login — not real auth).
PORTAL_PASSWORD=notajury
